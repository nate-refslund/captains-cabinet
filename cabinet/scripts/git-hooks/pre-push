#!/bin/bash
# pre-push — master-push gates: FW-007 force-refusal + FW-025b layer-separation
#            + FW-025c architecture census + FW-025 golden-evals
#
# Stops accidental destruction of master history in the shared working
# tree. On 2026-04-17 an officer ran `git reset --hard origin/master`
# in the shared tree and wiped 4 other officers' unpushed commits;
# FW-007 closes the push half of that hazard by refusing any push
# that would discard remote commits on master.
#
# What's blocked:
#   - `git push --force[-with-lease] origin master` (classic overwrite)
#   - `git push` after a local rebase/reset that rewrites published history
#   - `git push origin :master` (ref deletion — also destructive)
#
# What passes through untouched:
#   - Fast-forward pushes to master (normal merge pipeline).
#   - Pushes to any branch other than master.
#   - First-time ref creation (remote_sha all zeros).
#
# Announcement protocol (for genuine rebase pushes):
#   1. TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
#   2. Append one line to shared/force-push-log.md:
#        "$TS  <your-role>  <why the rewrite is necessary>"
#   3. Push within 5 minutes:
#        FORCE_PUSH_ANNOUNCED=$TS git push --force-with-lease origin master
#   Hook checks: env var present, timestamp well-formed, age <= 5 min,
#   exact timestamp string appears somewhere in the log file.
#
# Why belt-and-suspenders (both env var AND log line):
#   - The log line is the durable paper trail (committed artifact).
#   - The env var is the "intent signal" that proves this specific
#     invocation is the announced one, not a stale log line from last week.
#
# Portability: uses GNU `date -u -d` (Ubuntu/Debian/coreutils). macOS
# `date` does not accept `-d` with an ISO string. Officer containers
# are Ubuntu 24.04, so this is fine for the Cabinet; forkers running
# the hook from a macOS host will get a parse error and fail closed.
#
# Exit 0 = allow, Exit 1 = block. Stderr gets the reason on block —
# silent exits are banned (FW-022 lesson).
#
# Emergency escape hatch (rare, last-resort):
#   git push --no-verify origin master
# bypasses ALL client-side hooks — including FW-007 force-push refusal,
# the FW-025b layer-separation gate, the FW-025c architecture census, AND
# the FW-025 golden-eval gate. Use
# only when you're fixing a
# broken stop-hook/eval that is itself blocking the fix push, or when
# the eval suite's redis sandbox cannot start (redis-server binary
# absent — the suite no longer needs a RUNNING redis; it spawns its
# own throwaway, see lib/evals-redis-sandbox.sh). Document the usage in
# shared/force-push-log.md anyway so the team knows why the normal
# safeties were bypassed. `--no-verify` is a bigger hammer than
# FORCE_PUSH_ANNOUNCED (which only bypasses force-push refusal) — reach
# for it last. FW-026 tracks a finer-grained escape (SKIP_GOLDEN_EVALS
# or SKIP_EVAL_ANNOUNCED) that preserves FW-007 while bypassing FW-025.
#
# FW-025 scope limit (tracked as FW-026):
# The golden-eval gate evaluates the WORKING TREE state of
# cabinet/scripts/*, NOT the commit SHAs being pushed. Edge cases where
# broken commits can land despite a green gate:
#   * amend-off: WT has the fix, committed version is stale.
#   * selective-file commit: fix lives in un-staged WT, bad code in commit.
#   * parent-push (e.g. `git push origin HEAD^:master`): pushing an
#     ancestor commit while WT holds later fixes.
# Full mitigation requires `git stash && git checkout <local_sha> &&
# run evals && git restore` which is invasive and unsafe in a shared
# tree. Accepted for Phase A — officers should always `git status` clean
# before pushing. FW-026 will design a safer checkout-and-test flow.

set -u

ANNOUNCE_MAX_AGE_SEC=300
PROTECTED_REF="refs/heads/master"
LOG_REL="shared/force-push-log.md"
ZERO_SHA="0000000000000000000000000000000000000000"
EVAL_LOCK_TIMEOUT_SEC=30
# Hang guard, not a performance budget: the 26-eval suite measures ~74s
# on the live Mac (2026-07-07; the old 60s value dated from a ~12-eval
# suite and killed GREEN runs mid-flight at EVAL-018). ~4x observed.
EVAL_RUN_TIMEOUT_SEC=300

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$REPO_ROOT" ]; then
  echo "pre-push: not in a git repo — skipping" >&2
  exit 0
fi

LOG_PATH="$REPO_ROOT/$LOG_REL"

# Lock file inside .git/ rather than /tmp — /tmp is swept by tmpwatch
# and world-writable; a mid-run `rm /tmp/cabinet-golden-evals.lock`
# would create a new inode on next touch, breaking flock coordination
# across concurrent pushes. .git/ is per-repo, private, and stable.
# (COO adversary L-1 on 549062a.)
# Worktree-safe (2026-07-10): in a LINKED WORKTREE "$REPO_ROOT/.git" is a
# FILE (the gitdir pointer), so it cannot hold the lock — the redirect
# died with "Not a directory" and blocked the push before any eval ran.
# Use the COMMON git dir instead: one lock shared by the main checkout
# and every linked worktree, which is also the correct serialization
# scope (EVAL-008's evaltest_* Redis keys are shared per HOST, not per
# working tree). cd/pwd resolves the relative ".git" rev-parse emits at
# the main checkout; fallback preserves the old path if rev-parse fails.
GIT_COMMON_DIR="$(cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd)"
EVAL_LOCK_FILE="${GIT_COMMON_DIR:-$REPO_ROOT/.git}/cabinet-golden-evals.lock"

# Capture pushed refs once — stdin is single-use. Both the force-push
# loop (FW-007) and the golden-evals gate (FW-025) need to scan it.
REFS_INPUT=$(cat)

is_announced() {
  local env_ts="${FORCE_PUSH_ANNOUNCED:-}"
  if [ -z "$env_ts" ]; then
    return 1
  fi
  if ! echo "$env_ts" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'; then
    echo "pre-push: FORCE_PUSH_ANNOUNCED=$env_ts is malformed (want YYYY-MM-DDThh:mm:ssZ)" >&2
    return 1
  fi
  local now_epoch env_epoch age
  now_epoch=$(date -u +%s)
  # F0.3 (2026-07-02): BSD/macOS date lacks -d; try GNU first, then BSD -j -f.
  # Without the fallback this fail-closed on the platform the system runs on.
  env_epoch=$(date -u -d "$env_ts" +%s 2>/dev/null \
    || date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$env_ts" +%s 2>/dev/null \
    || echo 0)
  if [ "$env_epoch" = "0" ]; then
    echo "pre-push: FORCE_PUSH_ANNOUNCED=$env_ts could not be parsed as a date" >&2
    return 1
  fi
  age=$((now_epoch - env_epoch))
  if [ "$age" -lt 0 ]; then
    echo "pre-push: FORCE_PUSH_ANNOUNCED=$env_ts is in the future (host clock skew?)" >&2
    return 1
  fi
  if [ "$age" -gt "$ANNOUNCE_MAX_AGE_SEC" ]; then
    echo "pre-push: FORCE_PUSH_ANNOUNCED=$env_ts is ${age}s old (must be within ${ANNOUNCE_MAX_AGE_SEC}s)" >&2
    return 1
  fi
  # Reject symlinks — a hostile swap could point LOG_PATH at a world-writable
  # scratch file crafted to contain any timestamp (L4).
  if [ -L "$LOG_PATH" ]; then
    echo "pre-push: $LOG_REL is a symlink — log must be a regular tracked file" >&2
    return 1
  fi
  if [ ! -f "$LOG_PATH" ]; then
    echo "pre-push: $LOG_REL missing — announcement log is required" >&2
    return 1
  fi
  if ! grep -qF "$env_ts" "$LOG_PATH"; then
    echo "pre-push: no line in $LOG_REL matching timestamp $env_ts" >&2
    return 1
  fi
  return 0
}

BLOCK_REASON=""
PUSHES_MASTER=false
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "${remote_ref:-}" ]; then
    continue
  fi
  if [ "$remote_ref" != "$PROTECTED_REF" ]; then
    continue
  fi
  # From here on: this ref is the protected master branch.
  PUSHES_MASTER=true
  # Deleting master is destructive — require announcement.
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    BLOCK_REASON="delete of $PROTECTED_REF"
    continue
  fi
  # First-time creation (remote all zeros) is not an overwrite.
  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    continue
  fi
  # Fast-forward: remote_sha is an ancestor of local_sha. Allow.
  if git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    continue
  fi
  BLOCK_REASON="force overwrite of $PROTECTED_REF (remote $remote_sha is not an ancestor of local $local_sha — commits would be lost)"
done <<< "$REFS_INPUT"

# --- FW-025: Golden-evals gate on master pushes ---
# Runs the local golden-eval suite before any master push completes.
# Closes the cascade gap that let FW-022 (d45c8f2, 2026-04-21 19:16:17Z)
# silently break EVAL-001/002 for 56 minutes — no merge gate ran evals,
# so the breakage persisted until 8577433 (FW-022 regression catcher)
# landed and a human manually re-ran the suite.
#
# Fail-closed: any non-zero eval exit aborts the push with stderr.
# Silent-skip paths are banned (FW-022 lesson: silent skip = latent drift).
#
# Scope: only master pushes are gated. Feature-branch pushes skip (they
# get evaluated when merged and pushed to master).
#
# Concurrency: flock on $EVAL_LOCK_FILE serializes eval runs across
# officers sharing the tree. Historically this protected EVAL-008's
# shared evaltest_* Redis keys from cross-contamination; in sandbox
# mode (2026-07-17) each run has a PRIVATE ephemeral redis, so that
# hazard only remains where the endpoint is declared disposable (CI).
# Serialization is still wanted either way: the suite appends to shared
# non-Redis surfaces (scalar jsonl, /tmp transcripts) and one eval run
# at a time keeps FW-025 failures attributable. Cheap relative to the
# risk — full 26-eval suite measures ~74s on the live Mac (2026-07-07).
run_golden_evals_gate() {
  local eval_script="$REPO_ROOT/cabinet/scripts/run-golden-evals.sh"
  if [ ! -x "$eval_script" ]; then
    echo "pre-push: BLOCKED — $eval_script missing or not executable (FW-025)" >&2
    return 1
  fi
  if ! command -v flock >/dev/null 2>&1; then
    echo "pre-push: BLOCKED — flock(1) unavailable; FW-025 gate requires it" >&2
    echo "  install: apt-get install util-linux" >&2
    return 1
  fi
  echo "pre-push: FW-025 — running golden-eval suite before master push (serialized, ~75s)..." >&2
  (
    flock -w "$EVAL_LOCK_TIMEOUT_SEC" 200 || {
      echo "pre-push: golden-evals lock timeout after ${EVAL_LOCK_TIMEOUT_SEC}s — concurrent eval run?" >&2
      echo "  Inspect holder: fuser '$EVAL_LOCK_FILE' 2>/dev/null" >&2
      echo "  If stale, kill the holder PID (process died mid-run?) or remove the lock file." >&2
      exit 1
    }
    # timeout guards against a runaway run-golden-evals.sh hang —
    # otherwise every subsequent push would pay the 30s flock timeout
    # before blocking. Budget calibrated where EVAL_RUN_TIMEOUT_SEC is set.
    # Portability: timeout(1) is GNU coreutils — absent on stock macOS
    # (exit 127 here blocked a GREEN suite from reaching master). Resolve
    # timeout → gtimeout (homebrew coreutils) → perl SIGALRM (perl ships
    # with macOS; alarm survives exec, so a hung suite still dies at
    # EVAL_RUN_TIMEOUT_SEC). Same guard, three carriers — never a 127.
    if command -v timeout >/dev/null 2>&1; then
      timeout "$EVAL_RUN_TIMEOUT_SEC" bash "$eval_script"
    elif command -v gtimeout >/dev/null 2>&1; then
      gtimeout "$EVAL_RUN_TIMEOUT_SEC" bash "$eval_script"
    else
      perl -e 'alarm shift; exec @ARGV or die "exec: $!"' "$EVAL_RUN_TIMEOUT_SEC" bash "$eval_script"
    fi
  ) 200>"$EVAL_LOCK_FILE"
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    cat >&2 <<EOF
pre-push: BLOCKED — golden-eval suite failed (exit $rc). Fix the failure, re-run
  bash cabinet/scripts/run-golden-evals.sh
locally to confirm every eval passes before retrying the push.
EOF
    return 1
  fi
  return 0
}

# --- FW-025b: Layer-separation gate on master pushes ---
# Shift-left of the CI "Layer-separation gate (FINAL-C)" step. On 2026-07-14
# a merge landed 4 new FRAMEWORK_PATH_INSTANCE violations that passed the local
# pre-push (golden-evals only) but went red in CI — master stayed red across a
# whole push series before anyone noticed. This runs the SAME check locally so
# a push that would regress layer separation is refused before it can land red.
# Fast (~1s), stateless, no Redis/network — no flock needed. Same working-tree
# scope caveat as FW-025 (FW-026): it evaluates the WORKING TREE, not the pushed
# SHAs. Fail-closed: any non-zero exit (violation OR script error) aborts.
run_layer_sep_gate() {
  local ls_script="$REPO_ROOT/cabinet/scripts/check-layer-separation.sh"
  if [ ! -x "$ls_script" ]; then
    echo "pre-push: BLOCKED — $ls_script missing or not executable (FW-025b)" >&2
    return 1
  fi
  echo "pre-push: FW-025b — checking layer separation before master push (~1s)..." >&2
  if ! bash "$ls_script" >&2; then
    cat >&2 <<EOF
pre-push: BLOCKED — layer separation regressed (FW-025b). A framework/ file now
  references instance/ or presets/ that is not in the baseline/allowlist. Prefer
  fixing the coupling; if it is ratchet-down debt or Captain-ratified by-design,
  follow the gate's own guidance printed above (--update-baseline or the
  allowlist). Re-run to confirm:
    bash cabinet/scripts/check-layer-separation.sh
EOF
    return 1
  fi
  return 0
}

# --- FW-025c: Cognitive-architecture census on master pushes ---
# Shift-left of the census that already runs in CI (cabinet/scripts/
# verify-cognitive-phase4.sh, the cognitive-phase4 required job) and in
# cabinet/scripts/verify-cognitive-architecture.sh. Same script, same --check
# flag, same working-tree scope — the ONLY change is that a push which would
# breach an architecture budget is refused locally instead of going red on
# master minutes later, where every other writer inherits the red.
#
# Why this one and not "more checks": the census is the repo's expansion
# detector. Its budgets are pinned at ZERO HEADROOM (observed == max), so a
# single new central event type, action type, service row, framework module or
# framework line blocks until the growth is declared as a temporary_allowances
# row with its reason, owner, sunset and deletion gate. It is fast (~1s),
# read-only, stateless, needs no Redis or network, and never imports framework
# modules (it parses source), so it is safe to run on every master push.
#
# HONEST LIMIT, stated because a gate nobody can see through is worse than no
# gate: a fresh clone has core.hooksPath unset and .git/hooks/ holding samples
# only, and doctrine tells every subagent to work in its own clone — so this
# hook binds ZERO subagents by default. It catches honest mistakes from clones
# that ran install-git-hooks.sh; the required CI checks remain the floor.
#
# Fail-closed exactly like FW-025b: a missing script, a missing interpreter, a
# malformed contract and a real breach all block. An enforcement plane that
# fails open on its own absence is the worst fail-open there is.
run_census_gate() {
  local census="$REPO_ROOT/cabinet/scripts/cognitive-architecture-census.py"
  local py="${CABINET_PYTHON:-python3.12}"
  if [ ! -f "$census" ]; then
    echo "pre-push: BLOCKED — $census missing (FW-025c)" >&2
    return 1
  fi
  if ! command -v "$py" >/dev/null 2>&1; then
    echo "pre-push: BLOCKED — interpreter '$py' not on PATH; FW-025c census cannot run" >&2
    echo "  set CABINET_PYTHON to the house interpreter, or install python3.12 (+ PyYAML)" >&2
    return 1
  fi
  echo "pre-push: FW-025c — running the cognitive-architecture census before master push (~1s)..." >&2
  if ! PYTHONDONTWRITEBYTECODE=1 "$py" "$census" --root "$REPO_ROOT" --check >&2; then
    cat >&2 <<EOF
pre-push: BLOCKED — the cognitive-architecture census failed (FW-025c). Either a
  budget is breached or a temporary allowance has expired. The budgets sit at
  zero headroom on purpose: growth is declared, not absorbed. Fix the growth, or
  pay for it with a temporary_allowances row in
    cabinet/config/cognitive-architecture-contract.yml
  carrying the closed key set (phase, budget, additional, reason, owner, sunset,
  deletion_gate). Docstrings are counted honestly — never reformat them into '#'
  comments to duck the counter. Re-run to confirm:
    python3.12 cabinet/scripts/cognitive-architecture-census.py --check
EOF
    return 1
  fi
  return 0
}

if [ -z "$BLOCK_REASON" ]; then
  if $PUSHES_MASTER; then
    run_layer_sep_gate || exit 1
    run_census_gate || exit 1
    run_golden_evals_gate || exit 1
  fi
  exit 0
fi

if is_announced; then
  echo "pre-push: $BLOCK_REASON allowed — announcement $FORCE_PUSH_ANNOUNCED present in $LOG_REL" >&2
  if $PUSHES_MASTER; then
    run_layer_sep_gate || exit 1
    run_census_gate || exit 1
    run_golden_evals_gate || exit 1
  fi
  exit 0
fi

cat >&2 <<EOF
pre-push: BLOCKED — $BLOCK_REASON.

Master is the shared-tree ship point (FW-007). Force-push or ref
deletion destroys other officers' work. On 2026-04-17 this cost 4
unpushed commits.

To proceed with a legitimate rebase/overwrite push:
  1. TS=\$(date -u +%Y-%m-%dT%H:%M:%SZ)
  2. echo "\$TS  <your-role>  <why the rewrite is necessary>" >> $LOG_REL
  3. FORCE_PUSH_ANNOUNCED=\$TS git push --force-with-lease origin master

Hook requires the env var, a well-formed ISO UTC timestamp, a log
line containing that timestamp, and age <= ${ANNOUNCE_MAX_AGE_SEC}s.

Never use plain --force against master — always --force-with-lease,
and only after confirming no officer has unpushed commits on their
tree (git fetch && git log origin/master..HEAD on every officer's
working tree).
EOF

exit 1
