#!/bin/bash
# hatch-run.command — Hatch Cabinet v@APP_VERSION@ runner (built @BUILD_UTC@).
# Rendered from cabinet/scripts/appshell/hatch-run.command.in (HATCH-APPSHELL-V05).
#
# Installed into the cabinet prefix by the Hatch Cabinet.app stub and opened
# in Terminal via Launch Services. Orchestration only — zero hatch logic: it
# wraps the engine (cabinet/scripts/hatch.sh) in script(1) so the full
# Terminal transcript is self-recorded beside the engine's own flight log.
# Never invokes kill-switch.sh or start-dashboard.sh; opens no ports.
set -euo pipefail

PREFIX="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ARGS_FILE="$PREFIX/.hatch-run-args"

# Request handoff from the .app stub — strict allowlist; anything else
# degrades to a plain hatch (no move-in) with an honest note.
MODE="hatch"
WITH_LAUNCHD=0
if [ -f "$ARGS_FILE" ]; then
  REQUEST="$(head -n 1 "$ARGS_FILE" || true)"
  rm -f "$ARGS_FILE"
  case "$REQUEST" in
    hatch)                  MODE="hatch" ;;
    "hatch --with-launchd") MODE="hatch"; WITH_LAUNCHD=1 ;;
    doctor)                 MODE="doctor" ;;
    *) echo "hatch-run: unrecognized request '$REQUEST' — running plain hatch (no move-in)." ;;
  esac
fi

cd "$PREFIX"

if [ "$MODE" = "doctor" ]; then
  echo "hatch-run: cabinet doctor (probe-only, read-only) in $PREFIX"
  exec /bin/bash "$PREFIX/cabinet/scripts/cabinet-doctor.sh"
fi

STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
LOG_DIR="$HOME/hatch-logs/hatch-$STAMP"
mkdir -p "$LOG_DIR"
TRANSCRIPT="$LOG_DIR/terminal-transcript.txt"
FLIGHT_LOG="$LOG_DIR/flight.log"

echo "hatch-run: engine     $PREFIX/cabinet/scripts/hatch.sh"
if [ "$WITH_LAUNCHD" = "1" ]; then
  echo "hatch-run: flags      --defaults --with-launchd (move-in confirmed in the app)"
else
  echo "hatch-run: flags      --defaults (move-in deferred; the engine prints it as an errand note)"
fi
echo "hatch-run: transcript $TRANSCRIPT"
echo "hatch-run: flight log $FLIGHT_LOG"
echo ""

# Fixed argv throughout: the only variable flag is the literal --with-launchd,
# admitted solely by the allowlist above. script(1) needs a tty; without one
# (headless runs) the engine still runs, honestly noted, flight log intact.
set +e
if [ -t 0 ]; then
  if [ "$WITH_LAUNCHD" = "1" ]; then
    /usr/bin/script -q "$TRANSCRIPT" /bin/bash "$PREFIX/cabinet/scripts/hatch.sh" --defaults --with-launchd --flight-log "$FLIGHT_LOG"
  else
    /usr/bin/script -q "$TRANSCRIPT" /bin/bash "$PREFIX/cabinet/scripts/hatch.sh" --defaults --flight-log "$FLIGHT_LOG"
  fi
else
  echo "hatch-run: no tty — transcript recording skipped (flight log still written)."
  if [ "$WITH_LAUNCHD" = "1" ]; then
    /bin/bash "$PREFIX/cabinet/scripts/hatch.sh" --defaults --with-launchd --flight-log "$FLIGHT_LOG"
  else
    /bin/bash "$PREFIX/cabinet/scripts/hatch.sh" --defaults --flight-log "$FLIGHT_LOG"
  fi
fi
RC=$?
set -e

# The shell's exactly-one post-run notice: exit code and paths only (spec 3.5).
echo ""
echo "hatch.sh exited $RC — transcript + flight log: $LOG_DIR/"
exit "$RC"
