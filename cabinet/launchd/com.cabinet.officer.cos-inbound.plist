<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Chair inbound Telegram poller — the Captain's receive path.
     The telegram Channels plugin doesn't deliver DMs to an idle officer session, so
     this dedicated poller owns getUpdates for the Chair's bot and wakes the Chair's
     tmux session on each Captain message (see cabinet/scripts/officer-inbound-poller.py).
     Because it owns getUpdates, the Chair launches WITHOUT --channels (one poller per
     token; start-officer-mac.sh drops --channels when this plist exists).

     Install + load:
       cp cabinet/launchd/com.cabinet.officer.cos-inbound.plist ~/Library/LaunchAgents/
       launchctl load -w ~/Library/LaunchAgents/com.cabinet.officer.cos-inbound.plist
     Reverse: launchctl unload ~/Library/LaunchAgents/com.cabinet.officer.cos-inbound.plist

     PATH is load-bearing (launchd's minimal PATH omits Homebrew bin → no tmux/python).
     No secrets here: the bot token + CAPTAIN_TELEGRAM_ID are sourced from cabinet/.env
     by start-inbound-poller.sh at runtime.

     CABINET_VETO_WIRED=1 (lane-ops 2026-07-04) arms the TI-4 veto wire: the
     binder's never:/lift/`veto confirm` verbs PERSIST to
     shared/interfaces/captain-vetoes.yml (previously dark — parsed, recorded
     nothing), making run_action_lane's is_vetoed() a real pre-act block.
     Writes stay gated on captain_verified — this poller relays ONLY
     CAPTAIN_TELEGRAM_ID messages, so a veto is unforgeable. It only ever
     TIGHTENS autonomy (a veto blocks acting; it never widens anything).
     Rollback: delete the key + reload. Kept in sync with the cos-inbound row
     env in cabinet/services.yml (the generated plist carries it too). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cabinet.officer.cos-inbound</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/nate/captains-cabinet/cabinet/scripts/start-inbound-poller.sh</string>
    <string>cos</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- Parity fix (lane-ops 2026-07-04): the INSTALLED plist is generated from
         services.yml and has carried CABINET_BINDER_WIRED since the F0.5 deploy
         (2026-07-02) — this hand-made fallback copy had drifted without it, so
         installing it would have silently DISARMED mechanical verdict capture. -->
    <key>CABINET_BINDER_WIRED</key>
    <string>1</string>
    <key>CABINET_VETO_WIRED</key>
    <string>1</string>
    <!-- P3 one-door (review cp3 H1): the binder's edit: re-card sends via
         channel.send in THIS process; allow_sends() needs the runtime
         marker or every Captain edit: raises. -->
    <key>CABINET_ENV</key>
    <string>runtime</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/nate/Library/Logs/cabinet/cos-inbound.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nate/Library/Logs/cabinet/cos-inbound.err.log</string>
</dict>
</plist>
