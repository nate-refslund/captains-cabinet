<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- WEEKLY TI-7 act-first canary + breaker pass (checkpoint 2026-07-04
     condition 5). Monday 07:15 local it runs run-actfirst-canary.sh:
     per act-first-eligible kind a JOURNAL-ONLY synthetic create→verify→reverse
     cycle (canary:true rows, zero consequence-ledger emission), plus the kind
     breaker, silence breaker, veto-ledger divergence audit and env-perms
     check. Any canary failure or cannot-run freezes that kind inside
     actfirst_canary itself (no auto-unfreeze — a manual green canary lifts
     it); the runner surfaces results + PAGE lines to the log.

     Source of truth in repo; installed + loaded with:
       cp cabinet/launchd/com.cabinet.actfirst-canary.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.cabinet.actfirst-canary.plist

     DISABLE:
       launchctl bootout gui/$(id -u)/com.cabinet.actfirst-canary
       rm ~/Library/LaunchAgents/com.cabinet.actfirst-canary.plist

     No secrets here — the runner sources ~/.screenpipe/pipes/_shared/.env
     itself (Monday key never appears in this file or the log).
     KNOWN LIMIT: StartCalendarInterval missed during sleep coalesces to ONE
     fire on wake — on the MacBook the weekly slot may drift to first-wake
     Monday; the always-on Mac Mini keeps the true cadence. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cabinet.actfirst-canary</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/nate/captains-cabinet/cabinet/scripts/run-actfirst-canary.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/nate/captains-cabinet</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>REDIS_HOST</key>
    <string>localhost</string>
    <key>REDIS_PORT</key>
    <string>6379</string>
    <key>PYTHONPATH</key>
    <string>/Users/nate/captains-cabinet</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>15</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/nate/.cabinet/logs/actfirst-canary.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nate/.cabinet/logs/actfirst-canary.log</string>
</dict>
</plist>
