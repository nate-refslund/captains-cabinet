<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Limit-reset-watchdog LaunchAgent template.

Auto-resumes officers after an account session-limit reset (2026-06-25).
Scans each officer's tmux pane for the "You've hit your session limit · resets
H:MMpm" banner, stores the reset time as a UTC epoch at cabinet:limit-reset:<o>,
and fires the existing wake (notify-officer.sh → trigger_send) the moment the
reset is reached so the officer resumes its cabinet:active-task:<o>.

Fires every 3 minutes (StartInterval=180) — tighter than heartbeat's 5 min so a
reset is acted on within ~3 min of elapsing. Separate daemon from
heartbeat-watchdog by design: heartbeat RESTARTS dead officers (destructive
kickstart); a limit-blocked officer is ALIVE and must only be woken, never
restarted.

Install on Mac (envsubst-rendered by deploy-mac.sh):
    bash cabinet/scripts/deploy-mac.sh --daemon limit-reset-watchdog
(also registered by `deploy-mac.sh --all`).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cabinet.limit-reset-watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>${REPO_ROOT}/cabinet/cron/limit-reset-watchdog.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>${REPO_ROOT}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>${HOME}</string>
    <key>USER</key><string>${USER}</string>
    <key>CABINET_EVENT_LOG_DIR</key><string>${HOME}/Library/Application Support/cabinet/events</string>
    <key>REDIS_HOST</key><string>localhost</string>
    <key>REDIS_PORT</key><string>6379</string>
    <key>CABINET_SOURCE_REPO</key><string>${REPO_ROOT}</string>
    <key>PATH</key><string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key><string>en_US.UTF-8</string>
    <key>LC_ALL</key><string>en_US.UTF-8</string>
  </dict>

  <key>StartInterval</key>
  <integer>180</integer>

  <key>StandardOutPath</key>
  <string>${HOME}/Library/Logs/cabinet/limit-reset-watchdog.out.log</string>

  <key>StandardErrorPath</key>
  <string>${HOME}/Library/Logs/cabinet/limit-reset-watchdog.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
