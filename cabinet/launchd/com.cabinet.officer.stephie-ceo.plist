<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- STEPhie lane CEO as a durable always-on LaunchAgent (Captain decision 2026-06-24:
     CEOs run 24/7 on Opus 4.8 1M, max effort — "let's see how it goes"). Telegram-dark:
     it owns the STEPhie lane (tasks + Captain-ratified missions), spawns Sonnet crew, and
     surfaces to the Chair via notify-officer / the trigger bus — it never talks to Nate
     directly (start-officer-mac.sh gives a bot token only to telegram_bot=true officers).
     Install + load:
       cp cabinet/launchd/com.cabinet.officer.stephie-ceo.plist ~/Library/LaunchAgents/
       launchctl load -w ~/Library/LaunchAgents/com.cabinet.officer.stephie-ceo.plist
     Reverse: launchctl unload ~/Library/LaunchAgents/com.cabinet.officer.stephie-ceo.plist
     KeepAlive cycles it across crashes/reboots; start-officer-mac.sh babysits the tmux pane.
     CABINET_MODEL = Opus 4.8 1M (Fable 5 access-gated); effort is start-officer-mac.sh's max default. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cabinet.officer.stephie-ceo</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/nate/captains-cabinet/cabinet/scripts/start-officer-mac.sh</string>
    <string>stephie-ceo</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CABINET_ENV</key>
    <string>runtime</string>
    <key>REDIS_HOST</key>
    <string>localhost</string>
    <key>CABINET_MODEL</key>
    <string>claude-opus-4-8[1m]</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/nate/Library/Logs/cabinet/officer-stephie-ceo.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nate/Library/Logs/cabinet/officer-stephie-ceo.err.log</string>
</dict>
</plist>
