<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPORARY 30-min STATUS-SWEEP backstop for the Chair (cos officer).
     Every 1800s it runs run-status-sweep.sh, which pushes ONE status-sweep
     trigger to cabinet:triggers:cos. The redis-trigger-channel MCP (OFFICER_NAME=cos)
     delivers it live into the Chair's session; the Chair sweeps in-flight work and
     DMs Nate a tight digest. This is a BACKSTOP to the Redis trigger Channel: the
     Channel wakes officers on notify-officer messages but cannot wake a slept/idle
     session — this cron forces the sweep regardless.

     Source of truth in repo; installed + loaded with:
       cp cabinet/launchd/com.cabinet.status-sweep.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.cabinet.status-sweep.plist

     DISABLE (temporary — turning it off is meant to be trivial):
       launchctl bootout gui/$(id -u)/com.cabinet.status-sweep
       rm ~/Library/LaunchAgents/com.cabinet.status-sweep.plist   # optional, fully removes it

     No secrets here — the script reads none (it only pushes a Redis trigger on
     localhost). PATH/REDIS_HOST are set inside the script.

     KNOWN LIMIT: launchd StartInterval does NOT fire while the Mac is asleep, and
     a missed interval coalesces to a single fire on wake. On the MacBook this is a
     wake-time backstop only; true 24/7 cadence needs the always-on Mac Mini. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cabinet.status-sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/nate/captains-cabinet/cabinet/scripts/run-status-sweep.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/nate/.cabinet/logs/status-sweep.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nate/.cabinet/logs/status-sweep.log</string>
</dict>
</plist>
