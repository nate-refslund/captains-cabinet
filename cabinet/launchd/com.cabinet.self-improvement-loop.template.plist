<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Self-improvement loop LaunchAgent template (R8).
Closes the Cabinet's learning loop:
  eval results → pattern detection → evolution proposal → validation gate
  → auto-apply (captain-ratified, no manual wait) → hat graduations → skill induction.

ARMED 2026-07-07 (fleet manifest row `self-improvement-loop` in
cabinet/services.yml): this is the loop's ONLY clock — it had never been
scheduled anywhere (role-evals-weekly.sh invokes the driver inline, but
that cron was never armed either). The cadences are safe to overlap —
every loop run emits a unique `loop_id` and proposal application is
idempotent.

Schedule: every 6 hours (StartInterval 21600 — keep in lockstep with the
services.yml row; the outcome-watchdog derives this service's freshness
floor from the manifest, not from this file).

Instantiate (machine step, not repo state):
  REPO_ROOT=<repo> envsubst '$REPO_ROOT $HOME $USER' < this-template \
    > ~/Library/LaunchAgents/com.cabinet.self-improvement-loop.plist
  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.cabinet.self-improvement-loop.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cabinet.self-improvement-loop</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>${REPO_ROOT}/cabinet/cron/self-improvement-loop.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>${REPO_ROOT}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>${HOME}</string>
    <key>USER</key><string>${USER}</string>
    <key>CABINET_EVENT_LOG_DIR</key><string>${HOME}/Library/Application Support/cabinet/events</string>
    <key>REDIS_HOST</key><string>127.0.0.1</string>
    <key>REDIS_PORT</key><string>6379</string>
    <key>CABINET_ROOT</key><string>${REPO_ROOT}</string>
    <key>CABINET_SOURCE_REPO</key><string>${REPO_ROOT}</string>
    <key>OFFICER_NAME</key><string>self_improvement_loop</string>
    <key>PATH</key><string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key><string>en_US.UTF-8</string>
    <key>LC_ALL</key><string>en_US.UTF-8</string>
  </dict>

  <key>StartInterval</key>
  <integer>21600</integer>

  <key>StandardOutPath</key>
  <string>${HOME}/Library/Logs/cabinet/self-improvement-loop.out.log</string>

  <key>StandardErrorPath</key>
  <string>${HOME}/Library/Logs/cabinet/self-improvement-loop.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
