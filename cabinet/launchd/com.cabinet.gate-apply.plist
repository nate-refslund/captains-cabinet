<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- DARK — DO NOT LOAD [D15, sovereign spec 2026-07-04 §4 SOV-8].

     This is the root daemon for the germline code-apply lane
     (cabinet/scripts/gate-apply.sh watch: 72h apply-watch decisions +
     recorded-revert rollback). It SHIPS DARK by Captain ruling:

       * Disabled=true + RunAtLoad=false below;
       * NO setup script (setup-mac.sh / deploy-mac.sh / mac-preflight.sh /
         chair-preflight.sh / generate-instance.py) may copy, bootstrap, or
         load it — framework/learning/tests/test_gate_apply_dark.py greps
         that this Label appears in no setup script;
       * it may be armed ONLY by the Captain, explicitly, AFTER the
         unprivileged sandbox verify harness exists:
           sudo cp cabinet/launchd/com.cabinet.gate-apply.plist /Library/LaunchDaemons/
           sudo launchctl load -w /Library/LaunchDaemons/com.cabinet.gate-apply.plist
         (docs/runbooks/gate-apply-runbook.md is the full ritual.)

     Until armed, germline code apply stays Captain-manual in every posture:
     gate.ratify produces evidence packs; nothing applies them. The daemon,
     when armed, runs `watch` every 30 min — verify is NEVER run here as
     root (gate-apply.sh drops to $CABINET_VERIFY_USER; no root pytest). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cabinet.gate-apply</string>
  <key>Disabled</key>
  <true/>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/nate/captains-cabinet/cabinet/scripts/gate-apply.sh</string>
    <string>watch</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/nate/captains-cabinet</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/nate/captains-cabinet</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/nate/.cabinet/logs/gate-apply.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nate/.cabinet/logs/gate-apply.log</string>
</dict>
</plist>
