<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- DAILY falsifier report line (checkpoint 2026-07-04 condition 12: "a
     falsifier you cannot measure is theater"). 08:05 local it runs
     cabinet/scripts/falsifier-report.py, which READ-ONLY computes
     {date, acted_7d, approved_7d, reversal_rate_7d, stamped_rows_total,
     cells_accumulating, cells_graduated, proactive_cards_7d} from the
     consequence ledger + graduation engine + actfirst cap counters, and
     appends ONE json line (idempotent per date) to
     shared/interfaces/falsifier-series.jsonl — making the Day-14 / Day-30 /
     Quarter falsifiers mechanically observable.

     Source of truth in repo; installed + loaded with:
       cp cabinet/launchd/com.cabinet.falsifier-daily.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.cabinet.falsifier-daily.plist

     DISABLE:
       launchctl bootout gui/$(id -u)/com.cabinet.falsifier-daily
       rm ~/Library/LaunchAgents/com.cabinet.falsifier-daily.plist

     No secrets here or in the script — it reads no .env at all (ledger files
     + local Redis GET only). REDIS unreachable degrades to ledger-only counts.
     KNOWN LIMIT: a StartCalendarInterval slot missed during sleep coalesces to
     one fire on wake; the per-date idempotence makes double-fires harmless. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cabinet.falsifier-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3.12</string>
    <string>/Users/nate/captains-cabinet/cabinet/scripts/falsifier-report.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/nate/captains-cabinet</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>REDIS_HOST</key>
    <string>localhost</string>
    <key>REDIS_PORT</key>
    <string>6379</string>
    <key>PYTHONPATH</key>
    <string>/Users/nate/captains-cabinet</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>5</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/nate/.cabinet/logs/falsifier-daily.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nate/.cabinet/logs/falsifier-daily.log</string>
</dict>
</plist>
