<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- PARKED (lane-ops 2026-07-04) — DO NOT INSTALL. Superseded by the Captain's
     act-not-draft ruling (2026-07-03: the Captain owns all outbound comms; inbound
     becomes ACTION proposals via the action-lane, not reply drafts). The
     services.yml draft-lane row is `disabled: true` (the generator no longer
     renders it) and the LaunchAgents copy is parked as
     com.cabinet.draft-lane.plist.disabled. Kept in-repo for history / a
     possible Captain re-ruling only.

     Cabinet draft-reply lane (propose-half) — presents drafts to @example_cabinet_bot.
     Source of truth; install + load with:
       cp cabinet/launchd/com.cabinet.draft-lane.plist ~/Library/LaunchAgents/
       launchctl load -w ~/Library/LaunchAgents/com.cabinet.draft-lane.plist
     Reverse: launchctl unload ~/Library/LaunchAgents/com.cabinet.draft-lane.plist
     Propose-only — never sends to a recipient. No secrets here (wrapper reads cabinet/.env). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cabinet.draft-lane</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/nate/captains-cabinet/cabinet/scripts/run-draft-lane.sh</string>
  </array>
  <!-- P3 one-door: the lane now sends via framework.frontdoor.channel,
       whose allow_sends() gate requires the runtime marker - without it
       every card is silently blocked-dev. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>CABINET_ENV</key>
    <string>runtime</string>
  </dict>
  <key>StartInterval</key>
  <integer>7200</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/nate/.cabinet/logs/draft-lane.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nate/.cabinet/logs/draft-lane.log</string>
</dict>
</plist>
