<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- HOURLY graduation-transition emitter. Scheduled by lane-supply
     (services.yml single-writer, 2026-07-05) at the wave's AGREED path; the
     script itself (cabinet/scripts/emit-graduation-transitions.py) ships with
     the graduation lane of the SAME integration wave — do not install this
     plist before that script exists (same missing-file posture as
     regression-corpus: flip `disabled: true` on the graduation-transitions
     row in cabinet/services.yml rather than letting it thrash).

     Downstream of the verdict supply: the verifier + probes above feed the
     consequence-ledger cells; this emitter surfaces their promote/demote/hold
     crossings.

     Install (post-integration):
       cp cabinet/launchd/com.cabinet.graduation-transitions.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.cabinet.graduation-transitions.plist
     Disable:
       launchctl bootout gui/$(id -u)/com.cabinet.graduation-transitions
       rm ~/Library/LaunchAgents/com.cabinet.graduation-transitions.plist

     No secrets here — cabinet/.env is sourced by the wrapper at run time. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cabinet.graduation-transitions</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/nate/captains-cabinet &amp;&amp; set -a &amp;&amp; source cabinet/.env 2>/dev/null; set +a &amp;&amp; exec /opt/homebrew/bin/python3.12 cabinet/scripts/emit-graduation-transitions.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/nate/captains-cabinet</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/nate/captains-cabinet</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/nate/.cabinet/logs/graduation-transitions.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nate/.cabinet/logs/graduation-transitions.log</string>
</dict>
</plist>
