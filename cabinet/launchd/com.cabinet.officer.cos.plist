<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Chair (CoS front-door officer) as a durable LaunchAgent — Nate's single
     Telegram voice (@ExampleChairBot). Independent of any interactive session;
     survives logout/reboot. Install + load:
       cp cabinet/launchd/com.cabinet.officer.cos.plist ~/Library/LaunchAgents/
       launchctl load -w ~/Library/LaunchAgents/com.cabinet.officer.cos.plist
     Reverse: launchctl unload ~/Library/LaunchAgents/com.cabinet.officer.cos.plist
     KeepAlive restarts it across crashes/reboots; start-officer-mac.sh babysits
     the tmux pane and exits non-zero when claude dies so KeepAlive cycles it.

     EnvironmentVariables are load-bearing:
       PATH           — launchd's minimal PATH omits Homebrew bin; without it the
                        officer can't find redis-cli/jq/node/claude (the exact bug
                        class that silently killed the 07:30 briefing on 2026-06-23).
       CABINET_ENV    — runtime: front-door channel.send is unblocked (hard-wired
                        to CAPTAIN_TELEGRAM_ID; cannot reach a third party).
       REDIS_HOST     — durable intake + triggers.
       CABINET_MODEL  — Opus 4.8 1M (Fable 5 access-gated on this account; Captain-set).
     No secrets here — the bot token stays in cabinet/.env, sourced at runtime. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cabinet.officer.cos</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/nate/captains-cabinet/cabinet/scripts/start-officer-mac.sh</string>
    <string>cos</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CABINET_ENV</key>
    <string>runtime</string>
    <key>REDIS_HOST</key>
    <string>localhost</string>
    <key>CABINET_MODEL</key>
    <string>claude-opus-4-8[1m]</string>
    <!-- AUD-1 fleet rollout (audit 2026-07-07 #1, piloted on comms-officer):
         dedicated officer config home — no personal ~/.claude plugin set /
         auto-memory / corridor mandate. start-officer-mac.sh inlines both
         vars onto the claude launch line (tmux server-env gotcha).
         SECURESTORAGE set-to-EMPTY is deliberate: it drops CC's
         per-config-dir keychain suffix so the officer shares the default
         "Claude Code-credentials" OAuth item (fresh config homes have no
         creds; duplicating the item would race refresh rotation).
         cos receives Telegram via the cos-inbound watchdog (no --channels),
         so no telegram plugin is needed in the cabinet config home. -->
    <key>CLAUDE_CONFIG_DIR</key>
    <string>/Users/nate/Library/Application Support/cabinet/claude-config</string>
    <key>CLAUDE_SECURESTORAGE_CONFIG_DIR</key>
    <string></string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/nate/Library/Logs/cabinet/officer-cos.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nate/Library/Logs/cabinet/officer-cos.err.log</string>
</dict>
</plist>
