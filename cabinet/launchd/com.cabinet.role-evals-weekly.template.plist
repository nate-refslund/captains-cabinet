<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Role-evals-weekly LaunchAgent template.
Runs all registered role evals + scans for failure patterns that warrant
role-charter evolution proposals. Fires weekly (Monday 03:00 local)
per Phase 2 of the convergence plan.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cabinet.role-evals-weekly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>${REPO_ROOT}/cabinet/cron/role-evals-weekly.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>${REPO_ROOT}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>${HOME}</string>
    <key>USER</key><string>${USER}</string>
    <key>CABINET_EVENT_LOG_DIR</key><string>${HOME}/Library/Application Support/cabinet/events</string>
    <key>REDIS_HOST</key><string>127.0.0.1</string>
    <key>REDIS_PORT</key><string>6379</string>
    <key>CABINET_ROOT</key><string>${REPO_ROOT}</string>
    <key>CABINET_SOURCE_REPO</key><string>${REPO_ROOT}</string>
    <key>OFFICER_NAME</key><string>role_eval_runner</string>
    <key>PATH</key><string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key><string>en_US.UTF-8</string>
    <key>LC_ALL</key><string>en_US.UTF-8</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>${HOME}/Library/Logs/cabinet/role-evals-weekly.out.log</string>

  <key>StandardErrorPath</key>
  <string>${HOME}/Library/Logs/cabinet/role-evals-weekly.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
