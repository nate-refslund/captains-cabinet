<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hourly retro-trigger check (HIGH-8, scheduled 2026-07-03). The script is a
     cheap idempotent check: it fires the cross-officer RETRO + EVOLUTION trigger
     to the Chair (cos) only when due — 5+ reflections since the last retro OR the
     48h safety floor — otherwise logs "No retro yet" and exits.

     REGENERATED 2026-07-04 (lane-ops) from cabinet/services.yml by
     cabinet/scripts/generate-plists.py. WHY: the previous hand-made plist had
     NO PATH key, and launchd's minimal default PATH omits /opt/homebrew/bin —
     so every hourly run died "redis-cli: command not found" (FATAL since
     ~Jul 3). Root cause was the generator silently skipping `kind: cron`
     rows; the generator now renders cron and this file carries the same
     PATH as every healthy generated plist. Two deliberate deltas vs the old
     hand-made file: logs moved to ~/Library/Logs/cabinet/retro-trigger.{log,err}
     (generator convention — the outcome-watchdog probes BOTH old and new
     locations), and RunAtLoad=true (harmless: the script is idempotent and
     exits "No retro yet" when nothing is due).

     Source of truth in repo; installed + loaded with:
       cp cabinet/launchd/com.cabinet.retro-trigger.plist ~/Library/LaunchAgents/
       launchctl bootout gui/$(id -u)/com.cabinet.retro-trigger 2>/dev/null || true
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.cabinet.retro-trigger.plist

     DISABLE:
       launchctl bootout gui/$(id -u)/com.cabinet.retro-trigger
       rm ~/Library/LaunchAgents/com.cabinet.retro-trigger.plist

     No secrets in this file — the wrapper + script source cabinet/.env at
     runtime. KNOWN LIMIT (same as status-sweep): launchd StartInterval does
     not fire while the Mac sleeps; missed intervals coalesce to one fire on
     wake. -->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.cabinet.retro-trigger</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>cd /Users/nate/captains-cabinet &amp;&amp; set -a &amp;&amp; source cabinet/.env 2&gt;/dev/null &amp;&amp; set +a &amp;&amp; REDIS_HOST=localhost exec bash cabinet/cron/retro-trigger.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/nate/Library/Logs/cabinet/retro-trigger.err</string>
	<key>StandardOutPath</key>
	<string>/Users/nate/Library/Logs/cabinet/retro-trigger.log</string>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>WorkingDirectory</key>
	<string>/Users/nate/captains-cabinet</string>
</dict>
</plist>
