<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- DAILY Cabinet state backup (lane-ops 2026-07-04, closes CRIT-4: 19.7GB of
     runtime state with ZERO backups). 03:00 local it runs
     cabinet/scripts/backup.sh --retention-days 14, which snapshots
     shared/interfaces/ + instance/ + memory/ (rsync) and the Redis dump.rdb
     (BGSAVE) into ~/Cabinet-Backups/<YYYY-MM-DD>/ and prunes beyond 14 days.
     Verify restorability any time with cabinet/scripts/restore-drill.sh
     (temp-dir only — never touches live state).

     GENERATED from cabinet/services.yml by cabinet/scripts/generate-plists.py
     (manifest row: `backup`). Regenerate rather than hand-editing.

     Source of truth in repo; installed + loaded with:
       cp cabinet/launchd/com.cabinet.backup.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.cabinet.backup.plist

     DISABLE:
       launchctl bootout gui/$(id -u)/com.cabinet.backup
       rm ~/Library/LaunchAgents/com.cabinet.backup.plist

     NATE-DECISION (off-machine copy — deliberately NOT wired): a local-disk
     backup does not survive disk loss/theft. Recommendation: post-backup
     rsync of ~/Cabinet-Backups to the UpCloud CPH box over Tailscale (the
     8CPU/16GB node already on the tailnet). Ops wires it on your word.
     NATE-DECISION (Redis AOF — deliberately NOT flipped): BGSAVE is
     point-in-time only; cabinet/scripts/enable-redis-aof.sh flips
     appendonly+everysec but restarts Redis (brief trigger outage), so it
     stays a Captain step.

     No secrets in this file. KNOWN LIMIT: a 03:00 slot missed during sleep
     coalesces to one fire on wake; the per-day dated dir makes double-fires
     idempotent (re-run overwrites today's snapshot). -->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.cabinet.backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>cd /Users/nate/captains-cabinet &amp;&amp; set -a &amp;&amp; source cabinet/.env 2&gt;/dev/null &amp;&amp; set +a &amp;&amp; REDIS_HOST=localhost exec bash cabinet/scripts/backup.sh --retention-days 14</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/nate/Library/Logs/cabinet/backup.err</string>
	<key>StandardOutPath</key>
	<string>/Users/nate/Library/Logs/cabinet/backup.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>3</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/nate/captains-cabinet</string>
</dict>
</plist>
