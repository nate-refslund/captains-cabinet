<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac officer self-wake safety net (Gap 1, 2026-06-24). Every 2h, re-sends the
     per-officer `/loop` into each live `officer-<role>` tmux session so an officer
     that exited its loop gets re-armed without a full restart. Crash-restart is
     owned by each officer's own LaunchAgent KeepAlive; THIS only re-arms the loop.
     One pass per fire (StartInterval), so a hung pass can't wedge — launchd just
     runs the next one. RunAtLoad true: re-arm immediately on load/boot.
     Install + load:
       cp cabinet/launchd/com.cabinet.officer-supervisor-mac.plist ~/Library/LaunchAgents/
       launchctl load -w ~/Library/LaunchAgents/com.cabinet.officer-supervisor-mac.plist
     Reverse: launchctl unload ~/Library/LaunchAgents/com.cabinet.officer-supervisor-mac.plist
     No secrets here — it only sources cabinet/.env for REDIS_HOST parity. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cabinet.officer-supervisor-mac</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/nate/captains-cabinet &amp;&amp; set -a &amp;&amp; source cabinet/.env 2>/dev/null &amp;&amp; set +a &amp;&amp; REDIS_HOST=localhost /bin/bash cabinet/scripts/officer-supervisor-mac.sh</string>
  </array>
  <key>StartInterval</key><integer>7200</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/nate/Library/Logs/cabinet/officer-supervisor-mac.out.log</string>
  <key>StandardErrorPath</key><string>/Users/nate/Library/Logs/cabinet/officer-supervisor-mac.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CABINET_ENV</key><string>runtime</string>
    <key>REDIS_HOST</key><string>localhost</string>
  </dict>
</dict>
</plist>
