# =============================================================
# Captain's Cabinet — Environment Variables
# =============================================================
# Copy to .env and fill in all values. NEVER commit .env to git.
#
# This is the template for a single-product Cabinet deployment. Set
# CABINET_PREFIX to your product slug to namespace Redis keys + cabinet
# infrastructure tables.

# Telegram Bot Tokens (from @BotFather) — one per active officer.
TELEGRAM_COS_TOKEN=
TELEGRAM_CTO_TOKEN=
TELEGRAM_CRO_TOKEN=
TELEGRAM_CPO_TOKEN=
TELEGRAM_COO_TOKEN=

# Telegram Group & Captain
TELEGRAM_HQ_CHAT_ID=
CAPTAIN_TELEGRAM_ID=
# Local transport secret sent in Telegram's webhook authentication header.
# setup-env.sh generates this automatically; never paste or log its value.
TELEGRAM_WEBHOOK_SECRET=

# GitHub
GITHUB_PAT=

# Task system (set the one you use; leave others empty)
LINEAR_API_KEY=
# Optional: comma-separated name tokens (case-insensitive, first-name match)
# import-linear-to-library.sh uses to recognize the Captain as a Linear
# issue assignee (distinct from an officer). Unset/empty = no name is
# treated as the captain (product/captain-agnostic default — the framework
# never hardcodes a person's name). Example: CAPTAIN_ALIASES=jane,jane-doe
CAPTAIN_ALIASES=
# Monday.com — used by the STEP-Network/dev-tasks Claude plugin (44 MCP
# tools + 15 workflow skills). Variable name MUST be MONDAY_API_TOKEN
# (dev-tasks plugin reads exactly this name). The dev-tasks plugin
# replaces the cabinet's own Monday task adapter (which has been removed).
MONDAY_API_TOKEN=
JIRA_API_KEY=
ASANA_API_KEY=

# Work store Postgres connection string (historical name — every consumer
# reads it). Default: provision-local-postgres.sh writes a LOCAL
# PostgreSQL 16 + pgvector string here. Neon is the documented cloud
# alternative.
NEON_CONNECTION_STRING=

# Notion (Business Brain / strategy docs)
NOTION_API_KEY=

# Voyage AI (embeddings for cabinet_memory)
VOYAGE_API_KEY=

# Optional product integrations — connect only when an outcome demands them.
# Mapbox (if the product uses maps)
MAPBOX_TOKEN=
# Sentry (if you want cabinet to triage product errors)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Vercel (if the cabinet deploys the product)
VERCEL_TOKEN=
# PostHog (if the product has users to analyze)
POSTHOG_API_KEY=
POSTHOG_HOST=

# Research APIs (CRO uses these for market/competitor scans)
PERPLEXITY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
# Google AI Studio key — drives BOTH Gemini text/vision API calls AND
# Nano Banana (Gemini 2.5 Flash Image generation). Single key for both.
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# OpenAI — optional alternative for cua backend (CUA_MODEL_BACKEND=openai)
# or for officer Stagehand actions that prefer GPT-5.5. Skip if you're
# fully on Anthropic.
OPENAI_API_KEY=
# ElevenLabs — voice generation for Captain Telegram replies (the
# post-reply-voice.sh hook). Skip if Captain prefers text-only.
ELEVENLABS_API_KEY=

# Cabinet Infrastructure (internal PostgreSQL for memory — only if running
# your own PG sidecar; Neon is the recommended path)
POSTGRES_PASSWORD=
CABINET_PREFIX=captains-cabinet

# Dashboard (set a real password — leaving it as "changeme" exposes the
# dashboard to anyone who can reach the port).
DASHBOARD_PASSWORD=

# Claude Code (optional — only needed if NOT using Max subscription OAuth).
# If set, overrides subscription auth and bills per-token via API.
# Leave empty to use Max subscription (recommended).
# Also used by the cua MCP server when CUA_MODEL_BACKEND=anthropic (the
# default) — without this key, cua falls back to whichever local backend
# is configured. Setting it lets officers use Fable 5 for native Mac GUI
# control.
ANTHROPIC_API_KEY=

# ---- Captain-layer tool stack (screenpipe + cua + chrome-devtools) ----
# cua MCP model backend. Options: anthropic (default), openai,
# local-ui-tars-7b. Switch to local-ui-tars-7b for sovereignty/cost on
# high-volume repetitive native-GUI tasks.
CUA_MODEL_BACKEND=anthropic
# screenpipe data dir (default: ~/.screenpipe). Override if you want the
# 5-10GB/month of recording to live on an external drive.
# SCREENPIPE_DATA_DIR=
# Cabinet Chrome profile path (default: ~/.cabinet-chrome-profile). This is
# the isolated browser profile officers drive via chrome-devtools MCP —
# Captain logs into Linear/Monday/Notion/Gmail in this profile ONCE.
# CABINET_CHROME_PROFILE_DIR=
# Cabinet Chrome debug port (default: 9222). Always bound to 127.0.0.1 only.
# CABINET_CHROME_DEBUG_PORT=9222

# FW-005: Cross-Cabinet MCP HTTP transport (only needed for multi-Cabinet
# setups; single-Cabinet deployments leave this default).
CABINET_MCP_TRANSPORT=stdio
CABINET_MCP_PORT=7471
# Shared bearer secret — must match shared_secret_ref in peers.yml (same
# value on both Cabinets when running multi-Cabinet).
CABINET_PEER_SECRET_PERSONAL=

# --- Cabinet identity (multi-deployment estates) ---
CABINET_MODE=multi
CABINET_ID=hq-macbook            # MUST match outcomes.yml `deployment:` or zero missions compile

# --- Claude Code feature flags (admitted to officers only by the reviewed clean-env allowlist) ---
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1   # enables TeamCreate for officer crew bursts
