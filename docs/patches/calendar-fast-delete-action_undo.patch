+    """Reverse a calendar event: delete by UID in the named calendar. Empty
+    uid/calendar (a crash row) is a safe no-op.
+
+    FAST PATH — the signed EventKit helper's ``delete`` subcommand
+    (calendarItemExternalIdentifier lookup, scoped to the named calendar +
+    removeEvent(commit:true) + a post-delete re-query that CONFIRMS the event is
+    gone; exit 0 ONLY on a confirmed removal, <0.1s). The non-germline invoker
+    ``calendar_delete.delete_event`` owns helper-path resolution and the
+    confirmed-only contract, so this germline body stays a thin dispatcher.
+
+    FALLBACK — the proven AppleScript delete-by-uid (``_calendar_delete_script``,
+    a Calendar.app ``whose uid is`` scan, 14-45s). It keys on the SAME uid space
+    the writer stored (``uid of newEvent``), whereas the fast path relies on the
+    UNPROVEN uid == calendarItemExternalIdentifier equality — so ANY helper
+    uncertainty (0-match, denied/write-only, absent binary, unconfirmed, garbled)
+    MUST degrade to this authoritative path, never silently no-op.
+
+    SAFETY-CRITICAL: ``ok:True`` is returned ONLY on a CONFIRMED delete (helper
+    confirmation JSON, or AppleScript ``ok`` — the latter raising loudly when
+    Automation is denied). If BOTH paths fail, the reverse returns ok:False →
+    ``_reverse_rows`` journals reversal_failed + manual_cleanup; it NEVER claims
+    a delete it did not confirm."""
+    uid = args.get("uid")
+    cal = args.get("calendar")
+    if not uid or not cal:
+        return {"ok": True, "skipped": "no uid/calendar (crash/unexecuted row) — nothing to reverse"}
+    # FAST PATH: confirmed EventKit delete via the signed helper. Lazy import
+    # (no load-time cycle: calendar_delete -> calendar_read -> stdlib only). A
+    # CalendarDeleteError means the fast path could not CONFIRM — fall through.
+    from framework.frontdoor import calendar_delete
+    try:
+        fast = calendar_delete.delete_event(str(cal), str(uid), runner=osascript)
+        return {"ok": True, "detail": fast}
+    except calendar_delete.CalendarDeleteError:
+        pass                       # degrade to the authoritative AppleScript path
+    # FALLBACK: AppleScript delete-by-uid (authoritative for the stored uid;
+    # denied Automation raises out of osascript → not "ok" → ok:False).
+    res = osascript(["osascript", "-e", _calendar_delete_script(), str(cal), str(uid)])
+    if "ok" in (res or ""):
+        return {"ok": True, "detail": res}
+    return {"ok": False, "error": "calendar delete returned " + repr(res)}

