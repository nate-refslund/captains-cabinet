{
  "_comment": "Mac native .mcp.json — paths + Redis DNS resolved for Mac. Reviewer audit 2026-05-23 caught Docker DNS (redis://redis:6379) + /opt/ paths in master .mcp.json. start-officer-mac.sh will copy this to .mcp.json on first run (and deep-merge with instance/agents/<officer>/mcp.json if drives_computer=true).",
  "mcpServers": {
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": { "NOTION_TOKEN": "${NOTION_API_KEY}" }
    },
    "neon": {
      "command": "bash",
      "args": ["-c", "npx -y @neondatabase/mcp-server-neon start $NEON_API_KEY"],
      "env": { "NEON_API_KEY": "${NEON_API_KEY}" }
    },
    "linear": {
      "command": "npx",
      "args": ["-y", "@mseep/linear-mcp"],
      "env": { "LINEAR_API_KEY": "${LINEAR_API_KEY}" }
    },
    "vercel": {
      "command": "npx",
      "args": ["-y", "@robinson_ai_systems/vercel-mcp"],
      "env": { "VERCEL_TOKEN": "${VERCEL_API_KEY}" }
    },
    "redis-trigger-channel": {
      "command": "bun",
      "args": ["run", "${CABINET_SOURCE_REPO}/cabinet/channels/redis-trigger-channel/index.ts"],
      "env": { "OFFICER_NAME": "${OFFICER_NAME}", "REDIS_URL": "redis://localhost:6379" }
    },
    "library": {
      "command": "bun",
      "args": ["run", "${CABINET_SOURCE_REPO}/cabinet/channels/library-mcp/index.ts"],
      "env": { "OFFICER_NAME": "${OFFICER_NAME}" }
    },
    "_comment_captain_layer": "Below: Captain-layer tools (screen memory, browser hands, native Mac hands). Wired via setup-mac.sh Steps 9-12. Officer access gated by per-officer tools: allowlist in presets/work/agents/*.md — CoS sees everything; CTO/COO see playwright; others request via CoS.",
    "screenpipe": {
      "command": "npx",
      "args": ["-y", "screenpipe-mcp@latest"],
      "env": { "OFFICER_NAME": "${OFFICER_NAME}" }
    },
    "chrome_devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--browserUrl", "http://127.0.0.1:9222"],
      "env": { "OFFICER_NAME": "${OFFICER_NAME}" }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": { "OFFICER_NAME": "${OFFICER_NAME}" }
    },
    "cua": {
      "command": "cua-driver",
      "args": ["mcp", "--claude-code-computer-use-compat"],
      "env": {
        "OFFICER_NAME": "${OFFICER_NAME}",
        "CUA_MODEL_BACKEND": "${CUA_MODEL_BACKEND:-anthropic}",
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}"
      }
    }
  }
}
