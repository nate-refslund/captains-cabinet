# =============================================================
# probes.yml.example — the framework-shippable TWIN (egg row R120)
# =============================================================
# Copy to instance/config/probes.yml and map YOUR products. Every entry
# below is a placeholder — no real org, repo, or path ships in this file.
#
# Read by framework/probes/runner.py (the probe __main__ shell). Instance
# layer: THIS deployment's products; edit freely — a wrong/missing entry makes
# the probe SKIP that product with a printed reason (fail-closed: no verdict,
# never a fabricated observation). No secrets belong here: tokens live in
# your deployment's .env files and reach the probes via environment only
# (cabinet/scripts/run-probes.sh sources them).
#
# SCHEMA
#   github:   list of {repo: <owner/name gh slug>, checkout: <abs local path>}
#   vercel:   list of {app: <vercel app name>, checkout: <abs local path>}
#             (Team scoping is load-bearing and ENV-DRIVEN: probe_vercel.py
#              reads VERCEL_API_KEY + VERCEL_TEAM_ID from the environment —
#              set both for YOUR deployment (run-probes.sh sources .env), or
#              vercel probes query the wrong/default team and degrade to
#              skips. The v9 projects list truncates ids, so probes query by
#              app name within that team.)
#   sentry:   {org: <sentry org slug>, projects: [{project, checkout}]}
#
# WHY checkout is required per product: the probes' freshness guard and the
# B2.1 trailer fallback read LOCAL git (commit messages carry
# Cabinet-Proposal-Id) — the runner chdirs there before each probe cycle. A
# missing checkout = that product is skipped this run.

github:
  - repo: example-org/example-product
    checkout: /path/to/your/example-product-checkout

vercel:
  - app: example-product
    checkout: /path/to/your/example-product-checkout

sentry:
  org: <YOUR-SENTRY-ORG-SLUG>
  projects:
    - project: <YOUR-SENTRY-PROJECT-SLUG>
      checkout: /path/to/your/example-product-checkout
