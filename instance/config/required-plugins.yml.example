# required-plugins.yml — Claude Code plugins installed at officer boot.
#
# Copy this file to required-plugins.yml (no .example suffix) and edit for
# your deployment. The cabinet's install-plugins.sh reads this file and
# runs `claude plugin marketplace add <source>` + `claude plugin install <name>`
# for each entry.
#
# Plugins are user-level (~/.claude/plugins/) — installing once covers all
# 5 officer sessions. Per-project config goes in .claude/project-config.json
# (when the plugin requires it).
#
# Fields per plugin:
#   name          : plugin name (matches the plugin's manifest)
#   marketplace   : marketplace registered when source is added
#   source        : `claude plugin marketplace add <source>` arg — usually
#                   <org>/<repo> for GitHub-hosted, or local path for dev
#   description   : free-text for the install log
#   required_env  : env vars the plugin expects to be set (warn only — install
#                   proceeds either way; missing vars become a runtime issue
#                   only when officers invoke the plugin's tools)
#   optional      : if true, install failure is warn-only; if false, aborts
#                   setup-mac.sh

plugins:
  # STEP-Network's dev-tasks plugin (the Monday + GitHub + Vercel workflow
  # bundle the product team uses). Wraps Monday's GraphQL into 44 MCP tools,
  # 15 skills (/dev-tasks:pickup-task, /dev-tasks:ship-pr, etc.), 4
  # specialized subagents, 34 hooks (commit-id-gate, self-review, etc.).
  #
  # Requires gh auth status showing STEP-Network membership (private repo).
  # Captain MUST have MONDAY_API_TOKEN exported in the shell that launches
  # officer sessions (cabinet/.env is loaded by start-officer-mac.sh).
  #
  # Replaces the cabinet's own cabinet/scripts/task_adapters/monday.py
  # skeleton, which was deleted in favor of this purpose-built plugin.
  - name: dev-tasks
    marketplace: dev-tasks-marketplace
    source: STEP-Network/dev-tasks
    description: STEP-Network Monday.com + GitHub + Vercel workflow
    required_env:
      - MONDAY_API_TOKEN
    optional: false

  # Corridor is the security/regulatory static-analysis companion. STEP-wide
  # policy requires it installed alongside dev-tasks. Officers can't pass
  # /ship-pr without Corridor's BLOCKER findings being closed.
  #
  # Already declared at the user level in ~/.claude/CLAUDE.md — uncomment
  # below if you want setup-mac.sh to enforce a fresh install per cabinet
  # too (idempotent — no-op if already installed).
  #
  # - name: corridor
  #   marketplace: corridor-marketplace
  #   source: corridor-ai/corridor-claude-plugin
  #   description: Security + regulatory static analysis (companion to dev-tasks)
  #   required_env: []
  #   optional: false
