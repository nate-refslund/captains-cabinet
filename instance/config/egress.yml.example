# =============================================================
# instance/config/egress.yml — enforced egress allowlist (per-deployment override)
# =============================================================
# EXAMPLE / TEMPLATE. Copy to instance/config/egress.yml to override the
# framework default (framework/defaults/egress.yml). Instance values win over
# the framework default: scalars (`enforce`, `proxy_port`, `allow_product`)
# replace the default; `allow_hosts` is UNIONED with the framework floor so the
# control-plane hosts (api.anthropic.com, api.telegram.org) always survive.
#
# Provision this before the germline lock. After it is locked, enable/disable
# require the Captain unlock/edit/relock ceremony:
#   cabinet/scripts/egress-guard.sh enable    # unlock window: set true + install
#   cabinet/scripts/egress-guard.sh disable   # unlock window: set false + teardown
#   cabinet/scripts/egress-guard.sh status    # show resolved allowlist + proxy state
#   cabinet/scripts/egress-guard.sh dry-run   # show what WOULD be allowed/blocked, install nothing
#
# Coverage vs honest residual — Mac officers also receive a Seatbelt raw-socket
# denial; Linux/Docker needs a host/container network policy. Existing officers
# must be restarted: docs/runbooks/egress-allowlist.md.
# =============================================================

# Turn the allowlist ON for this deployment. The framework default is false =
# allow all. Setting true installs the allowlisting proxy; the guard FAILS
# CLOSED (errors non-zero, installs nothing) if it cannot verify the proxy.
enforce: true

# Local forward-proxy bind port (127.0.0.1). Inherit the default (8899) by
# omitting this key. macOS requires a fixed 1–65535 port so launchd restart does
# not change the endpoint already projected to officers; 0 is legacy child/test
# mode only.
# proxy_port: 8899

# Keep auto-including your own product hosts (org_domains from platform.yml /
# product.yml). Set false only if you want to list product hosts explicitly.
allow_product: true

# Hosts to permit IN ADDITION to the framework floor (api.anthropic.com,
# api.telegram.org) and your product's org_domains. Add the hosts your MCPs
# and tools actually call — anything not listed is refused when enforce is
# true. Subdomains of a listed host are allowed (`foo.com` covers
# `foo.com` and `api.foo.com`, but NOT `evilfoo.com`). Uncomment what you use:
allow_hosts:
  # - api.github.com          # GitHub MCP / gh CLI
  # - api.githubcopilot.com   # GitHub MCP transport
  # - api.exa.ai              # Exa search MCP
  # - api.perplexity.ai       # Perplexity MCP
  # - api.search.brave.com    # Brave Search MCP
  # - api.vercel.com          # Vercel MCP / CLI
  # - console.neon.tech       # Neon MCP
  # - api.monday.com          # Monday.com MCP
  # - us.api.anthropic.com    # regional Claude endpoint, if you route there
