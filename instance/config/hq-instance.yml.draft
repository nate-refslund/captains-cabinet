# =============================================================
# DRAFT for Nate review — HQ (MacBook) cabinet instance identity
# =============================================================
# PORTFOLIO ROSTER REWRITE (Captain-decided redesign 2026-06-10): the hq
# deployment moves from 5 functional officers (cos/cto/cpo/cro/coo) to a
# portfolio roster — one persistent Chair + per-lane CEO consultants.
# Functional depth comes from hats + hat_graduation and Sonnet crew, per
# presets/portfolio/. NOTHING reads this file automatically — instance
# identity is set via ENVIRONMENT VARIABLES, validated by
# cabinet/scripts/load-preset.sh (CABINET_ID validator, Phase 1 CP9b).
# This file is the declared source-of-truth values to export/seed at
# activation.
#
# ACTIVATION STEPS (manual, NOT done by this draft — this runbook and the
# R2 section of docs/clone-convergence-plan-2026-06-09.md are the SAME
# runbook; keep them in agreement):
#   1. cabinet/.env (chmod 600, gitignored) gets all four of:
#        TELEGRAM_COS_TOKEN=<Chair bot token>   # canonical name:
#                                               # TELEGRAM_<OFFICER_UPPER>_TOKEN
#                                               # (legacy TELEGRAM_BOT_TOKEN_COS
#                                               # still resolves as fallback)
#        TELEGRAM_HQ_CHAT_ID=<warroom chat id>
#        CABINET_MODE=multi
#        CABINET_ID=hq-macbook
#      In multi mode the boot ABORTS if CABINET_ID is unset — it will not
#      silently join 'main'. The outcomes deployment gate REQUIRES
#      CABINET_ID=hq-macbook: instance/config/outcomes.yml missions only
#      compile when CABINET_ID matches their deployment key — any other
#      value compiles ZERO missions.
#   2. Preset: instance/config/active-preset already says `portfolio`
#      (deployment-local file, gitignored — nothing to do).
#   3. Lane-CEO role defs already rendered (local, gitignored):
#      instance/agents/polads-ceo.md + instance/agents/stephie-ceo.md.
#   4. Seed the roster (file: instance/config/roster.yml, gitignored —
#      mirrors the roster block below):
#      bash cabinet/scripts/bootstrap-roles.sh --roster instance/config/roster.yml --prune
#      Seeds/updates EXACTLY these three roles — cos (Chair), polads-ceo,
#      stephie-ceo — and --prune retires any leftover cto/cpo/cro/coo rows
#      (yml archived, org_roles state -> retired).
#   5. TCC grants: bash cabinet/scripts/grant-mac-permissions.sh (interactive).
#   6. Deploy the Chair + core daemons:
#        bash cabinet/scripts/deploy-mac.sh --officer cos
#        bash cabinet/scripts/deploy-mac.sh --daemon mission-supervisor
#        bash cabinet/scripts/deploy-mac.sh --daemon outbox-relay
#      Optionally add heartbeat-watchdog + cost-summary (the cron scripts
#      now source cabinet/.env themselves, so their Telegram sends work).
#      SKIP task-sync (no-op for plugin-routed lanes — pointless) and SKIP
#      worktree-listener unless NEON_CONNECTION_STRING is set (it
#      crash-loops every 30s without it).
#   7. Lane CEOs are NOT deployed — they start on demand when their
#      trigger stream fills (mission-supervisor stderr/ledger shows the
#      routing):  bash cabinet/scripts/start-officer-mac.sh polads-ceo
#   8. Verify with ground truth: `tmux attach -t officer-cos` +
#      `redis-cli XLEN cabinet:triggers:<officer>` — NOT
#      verify-launchagents.sh as the gate (it only knows to skip
#      consultants once bootstrap has stamped officer_type; tmux + XLEN
#      is authoritative).
#
# THE MAC MINI SOAK INSTANCE KEEPS ITS OWN ID. It runs vanilla
# convergence-v2 in single mode (cabinet_id 'main' today) with the default
# 5-officer seed. Never share cabinet_id across machines: split-cabinet.sh
# restamps DB rows by cabinet_id, and a shared id would merge the two
# fleets' records irreversibly.

cabinet_id: hq-macbook
cabinet_mode: multi
machine: nates-macbook-pro
preset: portfolio
description: >
  Second cabinet instance of the same repo/branch (convergence-v2) on the
  MacBook: brain MCP bridge + portfolio of lanes (polads,
  stephie-stepnetwork, system-self) + comms via the queue_draft approval
  gate. Roster: Chair persistent (Fable 5, single bot), lane CEOs
  on-demand consultants with idle-stop, Telegram-dark, surfaced via the
  Chair + warroom. Quota choreography: Mini missions overnight, HQ fleet
  by day.

# -------------------------------------------------------------
# Roster — seeded by bootstrap-roles.sh --roster (this file)
# -------------------------------------------------------------
# Parser contract (bootstrap-roles.sh): 2-space role keys, 4-space
# title/model/capabilities/authority_level fields; type:/telegram: are
# read by humans + the supervisor config, ignored by bootstrap.
# capabilities mirror cabinet/officer-capabilities.conf where they
# overlap; mcp scope lives in cabinet/mcp-scope.yml (agents: cos,
# polads-ceo, stephie-ceo).
roster:
  cos:
    title: Chair
    type: fulltime                 # persistent session; supervisor auto-restarts
    model: claude-fable-5
    capabilities: [logs_captain_decisions, reviews_specs, reviews_implementations, validates_deployments]
    authority_level: captain_proxy
    # display name "Chair"; id stays cos — hooks/capabilities/heartbeats/
    # scope are keyed on it (see presets/portfolio/agents/cos.md header).
  polads-ceo:
    title: PolAds CEO
    type: consultant               # on-demand; spawned per trigger/mission, idle-stop
    model: claude-fable-5
    capabilities: [deploys_code, logs_captain_decisions]
    authority_level: mission_executor
    # telegram-dark: no bot; Captain attention via the Chair's
    # captain-attention queue + warroom broadcast.
  stephie-ceo:
    title: STEPhie & Website CEO   # lane stephie-stepnetwork (two repos, one lane)
    type: consultant
    model: claude-fable-5
    capabilities: [deploys_code, logs_captain_decisions]
    authority_level: mission_executor
    # telegram-dark, surfaced via Chair + warroom (same as polads-ceo).

# -------------------------------------------------------------
# Warroom — Telegram group for HQ broadcast
# -------------------------------------------------------------
# TOKEN-TBD: Nate creates the HQ group + invites the Chair bot, then sets
# the chat id in cabinet/.env. Never put the literal id/token in this file.
# Wire-up at activation: add per-context rows in instance/config/warrooms.yml
# pointing at ${TELEGRAM_HQ_CHAT_ID} (rows for the new contexts are NOT added
# yet — contexts ship inactive). Lane CEOs post lane updates here — it is
# their only outward surface besides the Chair's queue.
warroom:
  chat_id_env: TELEGRAM_HQ_CHAT_ID   # value lives in cabinet/.env (TOKEN-TBD)

# -------------------------------------------------------------
# Telegram — single-bot Chair surface (portfolio preset default)
# -------------------------------------------------------------
# TOKEN-TBD: Nate provides ONE new BotFather bot for the HQ Chair (do NOT
# reuse the Mini's tokens — two pollers on one token steal each other's
# updates). Username goes here once created; the token goes ONLY in
# cabinet/.env under the env var name listed. bot_mode single_ceo with
# ceo_officer cos means only the Chair's bot polls Telegram; lane CEOs are
# Telegram-dark and route Captain attention via the Chair
# (captain-attention queue), surfaced in DMs with attribution and in the
# warroom.
telegram:
  bot_mode: single_ceo
  ceo_officer: cos                   # the Chair (id-reuse)
  ceo_bot: ""                        # TOKEN-TBD — HQ Chair bot username
  bot_token_envs:
    cos: TELEGRAM_COS_TOKEN          # TOKEN-TBD in cabinet/.env (canonical
    # TELEGRAM_<OFFICER_UPPER>_TOKEN — the name start-officer-mac.sh
    # resolves first; legacy TELEGRAM_BOT_TOKEN_COS works as fallback).
    # polads-ceo / stephie-ceo: deliberately NO env names — Telegram-dark
    # in single_ceo mode. Add names here only if bot_mode is ever switched
    # to multi_officer.

# -------------------------------------------------------------
# Notes
# -------------------------------------------------------------
# - Redis: per-machine instance (HQ uses the MacBook's local Redis;
#   the Mini has its own). No shared Redis between instances.
# - Event ledger: CABINET_EVENT_LOG_DIR default is
#   ~/Library/Application Support/cabinet/events (durable, per-machine).
# - peers.yml: if HQ and the Mini ever need to talk, each declares the
#   other as a peer with consented_by_captain=true — not configured here.
# - Outcomes: instance/config/outcomes.yml (LIVE, Captain-ratified) is
#   already remapped to this roster (owners cos/polads-ceo/stephie-ceo;
#   cross-lane verifiers) and gated to deployment hq-macbook — it compiles
#   only when CABINET_ID=hq-macbook (see ACTIVATION step 1).
