# posture.yml — THE POSTURE SELECTION RULING [FI-1, sovereign-posture kernel].
#
# Selects WHICH verdicts table of the ONE authority matrix this deployment
# runs under. Verdict semantics live in the germline floor
# (framework/policies/authority-matrix.yml); this file only selects.
#
# THIS EXAMPLE SHIPS THE CONSENT-SAFE DEFAULT: posture guardian — the exact
# behavior an ABSENT file resolves to (propose-first everywhere autonomy has
# not been earned; hard ceilings Captain-gated forever). load-preset.sh
# materializes it to posture.yml on a fresh hatch ONLY when that file is
# absent, so day one shows the real governance state without changing it.
# Widening beyond guardian is ALWAYS a deliberate Captain ritual (below) —
# never a default, never automated.
#
# ABSENT file = guardian = today's exact behavior, byte-identical. The ruling
# takes effect ONLY when ALL of (framework/authority/posture.py):
#   present ∧ real path (a symlinked ruling is never attestable)
#   ∧ schema-valid (CLOSED keys — any unknown key is corrupt)
#   ∧ deployment == CABINET_ID env (default "main"; mismatch ⇒ treated absent)
#   ∧ schg-locked (os.lstat().st_flags & SF_IMMUTABLE; non-Darwin ⇒ never).
# Anything else resolves guardian (fail-safe polarity, D6) and a corrupt or
# unlocked file additionally files a deduped need. ONE exception (axes spec
# 2026-07-05 §1): `posture: earn_up` is honored even UNLOCKED — earn_up may
# only narrow vs guardian (matrix-validated), and narrowing is always safe.
# Widening to sovereign always requires the full lock ritual.
#
# Runtime may only NARROW: CABINET_POSTURE=guardian is the emergency
# drop-brake and CABINET_POSTURE=earn_up narrows further (both min-capped —
# env can never widen); CABINET_POSTURE=sovereign is IGNORED. The
# instance/config/posture-narrow file (single word guardian|earn_up,
# deliberately unlocked — the binder verb writes it) is a second narrow-only
# cap. There is NO dev/test bypass of the lock attestation.
#
# Tune + attest (Captain, in an unlock window):
#   $EDITOR instance/config/posture.yml   # set deployment/flavor/posture
#   git add + commit
#   sudo chflags schg instance/config/posture.yml
# Roll back: sudo chflags noschg … ; rm instance/config/posture.yml (absent ⇒ inert).
version: 1
status: ruled                  # only 'ruled' activates; anything else is corrupt
ruled_at: 2026-07-09T00:00:00Z
basis: "hatch default — guardian (propose-first) until the Captain rules otherwise"
deployment: main               # MUST equal CABINET_ID env (default "main")
flavor: org                    # org | personal — the identity axis (evidence
                               # supply + optimization target), NEVER authority
                               # semantics; external-comms refusal is the
                               # instance-scoped `never_grant` below, not flavor
                               # (Captain correction 2026-07-05)
posture: guardian              # guardian | earn_up | sovereign
# lanes: {}                    # OPTIONAL per-lane override of `posture`, e.g.
                               # {testburg-market: earn_up} — a lane may only
                               # be listed with a posture from the vocabulary
caps: {hard_multiplier: 10}    # runaway hard-stop = per-kind/day cap × this;
                               # freeze-on-hit in EVERY posture (FI-5)
# max_auto_exec_steps: 5       # sovereign only; guardian/earn_up are FORCED 2
# never_grant: []              # OPTIONAL: risk classes the Captain NEVER
                               # grants, any flavor (e.g. [external_comms]).
                               # Grant rows in these classes are dropped
                               # fail-closed at load + ONE kind=decision need
                               # per class. Empty/absent = all six ceiling
                               # classes grantable in sovereign.
# deployment_target: mac_mini  # OPTIONAL: macbook | mac_mini | docker — the
                               # topology axis; selects the attestation
                               # backend (AX-4). Absent ⇒ inferred:
                               # /.dockerenv ⇒ docker, else macbook.
