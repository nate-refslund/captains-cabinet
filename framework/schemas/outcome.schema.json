{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Outcomes",
  "description": "Captain-declared desired outcomes with measurable criteria",
  "type": "object",
  "required": ["outcomes"],
  "properties": {
    "deployment": {
      "type": "string",
      "description": "Optional deployment gate: when set, only the cabinet whose CABINET_ID matches this value compiles the file. Prevents a git-tracked live mission file from being compiled (and its tasks double-executed) by other deployments pulling the same branch."
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "measurable_criteria"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique outcome identifier, e.g. outcome-001"
          },
          "name": {
            "type": "string",
            "description": "Short name for the outcome"
          },
          "description": {
            "type": "string",
            "description": "Longer description of the desired outcome"
          },
          "measurable_criteria": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "Simple criterion — compiler infers role, dependencies, and defaults the other v2 fields"
                },
                {
                  "type": "object",
                  "description": "Rich criterion with Mission Compiler v2 fields. 'title' (or 'description') is required.",
                  "anyOf": [
                    {"required": ["title"]},
                    {"required": ["description"]}
                  ],
                  "properties": {
                    "node_id": {"type": "string", "description": "Explicit node id; auto-generated when omitted"},
                    "title": {"type": "string"},
                    "description": {"type": "string", "description": "Alias for title (legacy)"},
                    "owner_role": {"type": "string"},
                    "assigned_role": {"type": "string", "description": "Alias for owner_role"},
                    "acceptance_criteria": {
                      "oneOf": [
                        {"type": "string"},
                        {"type": "array", "items": {"type": "string"}}
                      ]
                    },
                    "evidence_required": {"type": "string"},
                    "verifier_role": {"type": "string"},
                    "risk_level": {"type": "string", "enum": ["", "low", "medium", "high"]},
                    "rollback_note": {"type": "string"},
                    "budget_note": {"type": "string"},
                    "captain_attention_estimate": {"type": "number", "minimum": 0},
                    "depends_on": {"type": "array", "items": {"type": "string"}}
                  },
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1,
            "description": "Concrete criteria to determine if outcome is achieved. Each item can be a simple string OR a rich Mission Compiler v2 object."
          },
          "status": {
            "type": "string",
            "enum": ["draft", "active", "achieved", "retired"],
            "default": "draft"
          },
          "captain_ratified": {
            "type": "boolean",
            "default": false
          },
          "ratified_at": {
            "type": "string",
            "description": "ISO 8601 date or datetime when captain ratified"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
