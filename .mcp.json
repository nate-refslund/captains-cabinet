{
  "mcpServers": {
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp",
      "headers": { "Authorization": "Bearer ${NEON_API_KEY}" }
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": { "NOTION_TOKEN": "${NOTION_API_KEY}" }
    },
    "vercel": {
      "command": "npx",
      "args": ["-y", "@robinson_ai_systems/vercel-mcp"],
      "env": { "VERCEL_TOKEN": "${VERCEL_TOKEN}", "VERCEL_TEAM_ID": "team_FEdAEOgfT3WhQ9c1moxCpO2s" }
    },
    "redis-trigger-channel": {
      "command": "bun",
      "args": ["run", "${CLAUDE_PROJECT_DIR}/cabinet/channels/redis-trigger-channel/index.ts"],
      "env": { "OFFICER_NAME": "${OFFICER_NAME:-captain-session}", "REDIS_URL": "${REDIS_URL:-redis://127.0.0.1:6379}" }
    },
    "cabinet-comms": {
      "command": "python3.12",
      "args": ["${CLAUDE_PROJECT_DIR}/framework/comms/mcp/server.py"],
      "env": { "COMMS_MCP_TRANSPORT": "stdio" }
    },
    "library": {
      "command": "bun",
      "args": ["run", "${CLAUDE_PROJECT_DIR}/cabinet/channels/library-mcp/index.ts"],
      "env": { "OFFICER_NAME": "${OFFICER_NAME:-captain-session}" }
    },
    "make": {
      "type": "http",
      "url": "https://eu2.make.com/mcp/stateless",
      "headers": { "Authorization": "Bearer ${MAKE_MCP_TOKEN}" }
    }
  }
}
